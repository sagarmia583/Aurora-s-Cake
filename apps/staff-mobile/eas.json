{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "android-release": {
      "extends": "production",
      "buildArtifactPaths": ["android/app/build/outputs/apk/release/*.apk"],
      "android": {
        "applicationArchivePath": "android/app/build/outputs/bundle/release/*.aab",
        "gradleCommand": ":app:assembleRelease :app:bundleRelease"
      }
    },
    "ios-device": {
      "distribution": "internal"
    },
    "ios-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
