{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/operations.js": {
      "maxDuration": 30
    },
    "api/image.js": {
      "maxDuration": 30
    },
    "api/public.js": {
      "maxDuration": 30
    },
    "api/backend-health.js": {
      "maxDuration": 30
    },
    "api/firebase-operations.js": {
      "maxDuration": 30
    },
    "api/firebase-health.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/operations",
      "destination": "/api/operations"
    },
    {
      "source": "/api/public",
      "destination": "/api/public"
    },
    {
      "source": "/api/image",
      "destination": "/api/image"
    },
    {
      "source": "/api/backend-health",
      "destination": "/api/backend-health"
    },
    {
      "source": "/api/firebase-health",
      "destination": "/api/firebase-health"
    },
    {
      "source": "/api/firebase-operations",
      "destination": "/api/firebase-operations"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ]
}
