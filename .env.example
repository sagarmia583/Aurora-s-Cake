# Aurora's Cake — free-only production configuration
# No Gemini API key, Cloud Run, SMS provider or paid payment gateway required.

# Public Google OAuth Web Client ID (not a secret).
# Used for optional customer Google account recovery and verified staff login.
# A public default is also embedded in src/config/googleOAuth.ts; keep synchronized if changing.
# The same ID must match Apps Script Property AURORA_GOOGLE_CLIENT_ID.
VITE_GOOGLE_OAUTH_CLIENT_ID="246617121730-fssfp59nlinltkfq0rccuud74rfpccum.apps.googleusercontent.com"

# Public Google Apps Script Web App /exec URL (not a secret).
# Use the deployment containing Code.gs, SeedData.gs, StaffOperations.gs,
# CustomerAccounts.gs, LiveCatalog.gs and CustomCakeRequests.gs.
VITE_GOOGLE_SHEETS_URL="https://script.google.com/macros/s/AKfycbw38J4AzlYkAhNtyDAp_CP34fUk9Epae6xz46AQFbF9ye1VsZjxTXmzbJgs52WEoWETMw/exec"

# Vercel Hobby OR Netlify Free: use the same-origin API function for
# Google Apps Script POST to avoid browser CORS/redirect failures.
# Set VITE_SHEETS_POST_PROXY=/api/operations in the HOSTING DASHBOARD.
# Set server-only AURORA_SCRIPT_POST_URL to the trusted deployed /exec URL.
# Leave empty when using local Vite dev without a running API function.
# Do NOT set any client secret in VITE_-prefixed variables.
VITE_SHEETS_POST_PROXY=""

# Registered Aurora's Cake Firebase Web App public configuration.
# Firebase is read-only during the staged migration; old order flows stay unchanged.
# Set false to disable. NEVER store Admin SDK credentials in VITE_ variables.
# See docs/FIREBASE_SETUP.md; Firestore must be created and rules deployed separately.
VITE_FIREBASE_ENABLED="true"
VITE_FIREBASE_API_KEY="AIzaSyCNVQv0iH6fAvzG5WxAX6om5yQGizrgxug"
VITE_FIREBASE_AUTH_DOMAIN="aurorascake-213a0.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="aurorascake-213a0"
VITE_FIREBASE_APP_ID="1:102515276771:web:d06431a890c12808f8fed6"
VITE_FIREBASE_MESSAGING_SENDER_ID="102515276771"
VITE_FIREBASE_STORAGE_BUCKET="aurorascake-213a0.firebasestorage.app"
VITE_FIREBASE_MEASUREMENT_ID="G-WRX6GNLXK4"
