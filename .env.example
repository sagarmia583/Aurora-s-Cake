# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public Google OAuth Web Client ID used by the Staff Portal (not a secret).
# Must match Script Property AURORA_GOOGLE_CLIENT_ID. Configure authorized JavaScript origins.
VITE_GOOGLE_OAUTH_CLIENT_ID=""

# Public, read-only Apps Script deployment URL (not a secret).
VITE_GOOGLE_SHEETS_URL="https://script.google.com/macros/s/AKfycbw38J4AzlYkAhNtyDAp_CP34fUk9Epae6xz46AQFbF9ye1VsZjxTXmzbJgs52WEoWETMw/exec"
